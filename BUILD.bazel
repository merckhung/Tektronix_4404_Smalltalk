load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

cc_library(
    name = "smalltalk_lib",
    defines = ["GC_MARK_SWEEP"],
    srcs = [
        "src/bitblt.cpp",
        "src/interpreter.cpp",
        "src/objmemory.cpp",
    ],
    hdrs = [
        "src/bitblt.h",
        "src/filesystem.h",
        "src/hal.h",
        "src/interpreter.h",
        "src/objmemory.h",
        "src/oops.h",
        "src/posixfilesystem.h",
        "src/realwordmemory.h",
    ],
    includes = ["src"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "smalltalk_tek",
    srcs = ["main_sdl.cpp"],
    copts = [
        "-std=c++17",
        "-I/usr/include/SDL2",
    ],
    deps = [
        ":smalltalk_lib",
    ],
    linkopts = [
        "-lSDL2",
    ],
)

# Headless boot recorder: runs the image without a window and logs every
# primitive, HAL and file-system call (input data for tools/bootviz).
cc_binary(
    name = "hal_trace",
    srcs = ["tools/hal_trace/hal_trace.cc"],
    copts = ["-std=c++17"],
    deps = [":smalltalk_lib"],
)
